OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# LangSmith (default observability provider).
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=delivery7

# Host 6380 → Redis Stack in docker-compose (avoids plain Redis on 6379).
REDIS_URL=redis://localhost:6380/0
CHECKPOINT_BACKEND=redis
OBSERVABILITY_PROVIDER=langsmith

# Phoenix (used when OBSERVABILITY_PROVIDER=phoenix).
# Inside docker-compose use http://phoenix:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Optional. Defaults match the values used by the orchestrator.
# LLM_PROVIDER=openai
# RECURSION_LIMIT=25
# SPECIALIST_RECURSION_LIMIT=12
# MAX_SUPERVISOR_STEPS=6
# MAX_SPECIALIST_RUNS=2
# TAVILY_MAX_RESULTS=5
# ARTIFACT_EXCERPT_CHARS=4000
# JOB_TTL_SECONDS=86400
